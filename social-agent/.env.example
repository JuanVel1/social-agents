# Proveedor del modelo: gemini (capa gratuita) o fake (sin red, para pruebas)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Confirma los nombres exactos con: social-agent models
GEMINI_MODEL_QUALITY=gemini-3.5-flash
GEMINI_MODEL_BULK=gemini-3.5-flash-lite
# Si el modelo está saturado (503) o sin cuota (429) se prueba con estos, en orden
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
# Generación de imágenes de la persona de la marca (estilos con generate_photos: true).
# No está en la capa gratuita: requiere facturación activa en el proyecto de AI Studio.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# Personaje 3D animado (estilos con character: true). Token de lectura de huggingface.co/settings/tokens.
# La cuota gratuita de GPU da para ~3 imágenes al día; `serve` llena el banco de poses por tandas.
HUGGINGFACE_API_TOKEN=
CHARACTER_SPACE=Qwen/Qwen-Image-Edit
CHARACTER_POLL_HOURS=3
# Límite propio por debajo del de la capa gratuita (10-15 por minuto)
GEMINI_MAX_RPM=8

# Notion: integración interna y base de datos "Parrilla" (ver README)
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Base "Onboarding de clientes" (se crea con: social-agent onboarding setup --parent <página>)
NOTION_ONBOARDING_DATABASE_ID=

# Postiz autoalojado: URL del backend y API key pública (Settings > Public API)
POSTIZ_URL=http://localhost:5000
POSTIZ_API_KEY=

# Zona horaria de publicación
TIMEZONE=America/Bogota

# Cada cuántos segundos `serve` revisa en Notion las filas aprobadas y las nuevas del onboarding
APPROVAL_POLL_SECONDS=60

# Banco de fotos: el token de Instagram se lee (solo lectura) del Postgres de Postiz con `docker exec`
POSTIZ_DB_CONTAINER=postiz-postgres
POSTIZ_DB_USER=postiz-user
POSTIZ_DB_NAME=postiz-db-local

# Subtítulos de Reels con faster-whisper (small va bien en CPU; medium si falla mucho con ruido)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
